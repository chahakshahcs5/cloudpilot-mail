\\r\\n:center; padding:10px 20px; font-size:0px\\\">\\r\\n        <img alt=3D\\\"kimi-k3-contest\\\" src=3D\\\"https://hs-44215135.f.hubspotem=\\r\\nail-na2.net/hub/44215135/hubfs/kimi-k3-contest.png?width=3D1120&amp;upscale=\\r\\n=3Dtrue&amp;name=3Dkimi-k3-contest.png\\\" style=3D\\\"outline:none; text-decorat=\\r\\nion:none; max-width:100%; font-size:16px\\\" width=3D\\\"560\\\" align=3D\\\"middle\\\">\\r\\n      </td>\\r\\n    </tr>\\r\\n  </tbody>\\r\\n</table></div>\\r\\n  <table role=3D\\\"presentation\\\" cellpadding=3D\\\"0\\\" cellspacing=3D\\\"0\\\" width=3D=\\r\\n\\\"100%\\\" class=3D\\\"\\\" style=3D\\\"\\\"><tbody><tr><td class=3D\\\"hs_padded\\\" style=3D\\\"fo=\\r\\nnt-family:Arial, sans-serif; font-size:15px; color:#23496d; word-break:brea=\\r\\nk-word; padding:10px 20px\\\"><div id=3D\\\"hs_cos_wrapper_module_17855373861991\\\"=\\r\\n class=3D\\\"hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_module\\\" =\\r\\nstyle=3D\\\"color: inherit; font-size: inherit; line-height: inherit;\\\" data-hs=\\r\\n-cos-general-type=3D\\\"widget\\\" data-hs-cos-type=3D\\\"module\\\"><div id=3D\\\"hs_cos_=\\r\\nwrapper_module_17855373861991_\\\" class=3D\\\"hs_cos_wrapper hs_cos_wrapper_widg=\\r\\net hs_cos_wrapper_type_rich_text\\\" style=3D\\\"color: inherit; font-size: inher=\\r\\nit; line-height: inherit;\\\" data-hs-cos-general-type=3D\\\"widget\\\" data-hs-cos-=\\r\\ntype=3D\\\"rich_text\\\"><h3 style=3D\\\"font-size:17px; margin:0; line-height:175%;=\\r\\n font-weight:bold\\\">Train K3 on your own data</h3>\\r\\n<p style=3D\\\"line-height:175%\\\">Serverless training for Kimi K3 also went liv=\\r\\ne on Monday. With a one-line SDK change, jobs run on shared GPUs so you can=\\r\\n pay per token with no idle costs or headaches wrangling GPU clusters. <a h=\\r\\nref=3D\\\"https://d5bPYQ04.na2.hubspotlinks.com/Ctc/ZX+113/d5bPYQ04/VVzrfQ7m9v=\\r\\n6RW4rYWsb1wzfb2W4dVnpw5S8DdfN6crjq23qn9qW95jsWP6lZ3l7W1PbTc43KTX6DN3mYdjsLr=\\r\\nq3fW708cfc659r5qW7McsxB4nmxMn