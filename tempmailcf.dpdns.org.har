width: 72px !important;\\r\\n    }\\r\\n    table.onboarding-card-media-frame-photo {\\r\\n      width: 144px !important;\\r\\n      max-width: 144px !important;\\r\\n    }\\r\\n    table.onboarding-card-media-frame-photo-gap,\\r\\n    table.onboarding-card-photo-split-gap {\\r\\n      width: 145px !important;\\r\\n      max-width: 145px !important;\\r\\n    }\\r\\n    td.onboarding-card-media-fill {\\r\\n      height: 72px !important;\\r\\n    }\\r\\n    td.onboarding-card-media-fill-photo {\\r\\n      height: 72px !important;\\r\\n    }\\r\\n    td.onboarding-card-media-fill-icon {\\r\\n      height: auto !important;\\r\\n      padding: 10px !important;\\r\\n    }\\r\\n    img.onboarding-card-icon-art,\\r\\n    table.onboarding-card-icon-art {\\r\\n      width: 52px !important;\\r\\n      max-width: 52px !important;\\r\\n      height: 52px !important;\\r\\n    }\\r\\n    td.onboarding-card-media-fill-icon-full-frame {\\r\\n      height: 72px !important;\\r\\n      padding: 0 !important;\\r\\n    }\\r\\n    img.onboarding-card-icon-art-full-frame,\\r\\n    table.onboarding-card-icon-art-full-frame {\\r\\n      width: 72px !important;\\r\\n      max-width: 72px !important;\\r\\n      height: 72px !important;\\r\\n    }\\r\\n    img.onboarding-card-photo-art {\\r\\n      width: 72px !important;\\r\\n      height: 72px !important;\\r\\n      max-width: 72px !important;\\r\\n    }\\r\\n    img.onboarding-card-photo-art-wide {\\r\\n      width: 144px !important;\\r\\n      height: 72px !important;\\r\\n      max-width: 144px !important;\\r\\n    }\\r\\n    td.onboarding-card-photo-split-cell-before,\\r\\n    img.onboarding-card-photo-art-half-before,\\r\\n    table.onboarding-card-photo-placeholder-half-before {\\r\\n      width: 72px !important;\\r\\n      max-width: 72px !important;\\r\\n    }\\r\\n    td.onboarding-card-photo-split-cell-after,\\r\\n    img.onboarding-card-photo-art-half-after,\\r\\n    table.onboarding-card-photo-placeholder-half-after {\\r\\n      width: 72px !important;\\r\\n      max-width: 72px !important;\\r\\n    }\\r\\n    td.onboarding-card-photo-split-gap {\\r\\n      width: 1px !important;\\r\\n      min-width: 1px !important;\\r\\n    }\\r\\n    img.onboarding-card-photo-art-half,\\r\\n    table.onboarding-card-photo-placeholder-half,\\r\\n    td.onboarding-card-photo-placeholder-fill {\\r\\n      height: 72px !important;\\r\\n    }\\r\\n    td.onboarding-card-gap {\\r\\n      width: 12px !important;\\r\\n      min-width: 12px !important;\\r\\n    }\\r\\n    p.onboarding-card-copy {\\r\\n      font-size: 13px !important;\\r\\n      line-height: 18px !important;\\r\\n      letter-spacing: -0.24px !important;\\r\\n    }\\r\\n    td.onboarding-card-arrow-cell {\\r\\n      width: 28px !important;\\r\\n      min-width: 28px !important;\\r\\n      padding-left: 6px !important;\\r\\n    }\\r\\n    [dir=3D\\\"rtl\\\"] td.onboarding-card-arrow-cell {\\r\\n      padding-left: 0 !important;\\r\\n      padding-right: 6px !important;\\r\\n    }\\r\\n    img.onboarding-card-arrow-img {\\r\\n      width: 24px !important;\\r\\n      height: 24px !important;\\r\\n    }\\r\\n  }\\r\\n  @media screen and (max-width:360px) {\\r\\n    h1.onboarding-section-title {\\r\\n      font-size: 25px !important;\\r\\n      line-height: 31px !important;\\r\\n    }\\r\\n    p.onboarding-section-body {\\r\\n      font-size: 13px !important;\\r\\n      line-height: 142% !important;\\r\\n    }\\r\\n    td.content-td.onboarding-card-section {\\r\\n      padding-left: 8px !important;\\r\\n      padding-right: 8px !important;\\r\\n    }\\r\\n    td.email-footer-row {\\r\\n      padding-left: 8px !important;\\r\\n      padding-right: 8px !important;\\r\\n    }\\r\\n    td.onboarding-card-padding {\\r\\n      padding: 10px !important;\\r\\n    }\\r\\n    td.onboarding-card-media-cell {\\r\\n      width: 64px !important;\\r\\n      min-width: 64px !important;\\r\\n    }\\r\\n    td.onboarding-card-media-cell-photo {\\r\\n      width: 136px !important;\\r\\n      min-width: 136px !important;\\r\\n    }\\r\\n    td.onboarding-card-media-cell-photo-gap {\\r\\n      width: 137px !important;\\r\\n      min-width: 137px !important;\\r\\n    }\\r\\n    table.onboarding-card-media-frame {\\r\\n      width: 64px !important;\\r\\n      max-width: 64px !important;\\r\\n    }\\r\\n    table.onboarding-card-media-frame-photo {\\r\\n      width: 136px !important;\\r\\n      max-width: 136px !important;\\r\\n    }\\r\\n    table.onboarding-card-media-frame-photo-gap,\\r\\n    table.onboarding-card-photo-split-gap {\\r\\n      width: 137px !important;\\r\\n      max-width: 137px !important;\\r\\n    }\\r\\n    td.onboarding-card-media-fill {\\r\\n      height: 64px !important;\\r\\n    }\\r\\n    td.onboarding-card-media-fill-photo {\\r\\n      height: 68px !important;\\r\\n    }\\r\\n    td.onboarding-card-media-fill-icon {\\r\\n      height: auto !important;\\r\\n      padding: 8px !important;\\r\\n    }\\r\\n    img.onboarding-card-icon-art,\\r\\n    table.onboarding-card-icon-art {\\r\\n      width: 48px !important;\\r\\n      max-width: 48px !important;\\r\\n      height: 48px !important;\\r\\n    }\\r\\n    td.onboarding-card-media-fill-icon-full-frame {\\r\\n      height: 64px !important;\\r\\n      padding: 0 !important;\\r\\n    }\\r\\n    img.onboarding-card-icon-art-full-frame,\\r\\n    table.onboarding-card-icon-art-full-frame {\\r\\n      width: 64px !important;\\r\\n      max-width: 64px !important;\\r\\n      height: 64px !important;\\r\\n    }\\r\\n    img.onboarding-card-photo-art {\\r\\n      width: 64px !important;\\r\\n      height: 64px !important;\\r\\n      max-width: 64px !important;\\r\\n    }\\r\\n    img.onboarding-card-photo-art-wide {\\r\\n      width: 136px !important;\\r\\n      height: 68px !important;\\r\\n      max-width: 136px !important;\\r\\n    }\\r\\n    td.onboarding-card-photo-split-cell-before,\\r\\n    img.onboarding-card-photo-art-half-before,\\r\\n    table.onboarding-card-photo-placeholder-half-before {\\r\\n      width: 68px !important;\\r\\n      max-width: 68px !important;\\r\\n    }\\r\\n    td.onboarding-card-photo-split-cell-after,\\r\\n    img.onboarding-card-photo-art-half-after,\\r\\n    table.onboarding-card-photo-placeholder-half-after {\\r\\n      width: 68px !important;\\r\\n      max-width: 68px !important;\\r\\n    }\\r\\n    td.onboarding-card-photo-split-gap {\\r\\n      width: 1px !important;\\r\\n      min-width: 1px !important;\\r\\n    }\\r\\n    img.onboarding-card-photo-art-half,\\r\\n    table.onboarding-card-photo-placeholder-half,\\r\\n    td.onboarding-card-photo-placeholder-fill {\\r\\n      height: 68px !important;\\r\\n    }\\r\\n    td.onboarding-card-gap {\\r\\n      width: 10px !important;\\r\\n      min-width: 10px !important;\\r\\n    }\\r\\n    p.onboarding-card-copy {\\r\\n      font-size: 12px !important;\\r\\n      line-height: 16px !important;\\r\\n    }\\r\\n    td.onboarding-card-arrow-cell {\\r\\n      width: 24px !important;\\r\\n      min-width: 24px !important;\\r\\n      padding-left: 4px !important;\\r\\n    }\\r\\n    [dir=3D\\\"rtl\\\"] td.onboarding-card-arrow-cell {\\r\\n      padding-left: 0 !important;\\r\\n      padding-right: 4px !important;\\r\\n    }\\r\\n    img.onboarding-card-arrow-img {\\r\\n      width: 20px !important;\\r\\n      height: 20px !important;\\r\\n    }\\r\\n  }\\r\\n</style>\\r\\n\\r\\n  <style type=3D\\\"text/css\\\">\\r\\n  /**\\r\\n   * Google webfonts. Recommended to include the .woff version for cross-cl=\\r\\nient compatibility.\\r\\n   */\\r\\n  @media screen {\\r\\n    /* OpenAI Sans font family */\\r\\n    @font-face {\\r\\n      font-display: swap;\\r\\n      font-family: \\\"OpenAI Sans\\\";\\r\\n      font-style: normal;\\r\\n      font-weight: 400;\\r\\n      src: url(\\\"https://cdn.openai.com/common/fonts/openai-sans/v2/OpenAISa=\\r\\nns-Regular.woff2\\\") format(\\\"woff2\\\");\\r\\n    }\\r\\n\\r\\n    @font-face {\\r\\n      font-display: swap;\\r\\n      font-family: \\\"OpenAI Sans\\\";\\r\\n      font-style: normal;\\r\\n      font-weight: 500;\\r\\n      src: url(\\\"https://cdn.openai.com/common/fonts/openai-sans/v2/OpenAISa=\\r\\nns-Medium.woff2\\\") format(\\\"woff2\\\");\\r\\n    }\\r\\n\\r\\n    @font-face {\\r\\n      font-display: swap;\\r\\n      font-family: \\\"OpenAI Sans\\\";\\r\\n      font-style: normal;\\r\\n      font-weight: 600;\\r\\n      src: url(\\\"https://cdn.openai.com/common/fonts/openai-sans/v2/OpenAISa=\\r\\nns-Semibold.woff2\\\") format(\\\"woff2\\\");\\r\\n    }\\r\\n\\r\\n    @font-face {\\r\\n      font-display: swap;\\r\\n      font-family: \\\"OpenAI Sans\\\";\\r\\n      font-style: normal;\\r\\n      font-weight: 700;\\r\\n      src: url(\\\"https://cdn.openai.com/common/fonts/openai-sans/v2/OpenAISa=\\r\\nns-Bold.woff2\\\") format(\\\"woff2\\\");\\r\\n    }\\r\\n  }\\r\\n\\r\\n  :root {\\r\\n    color-scheme: light dark only;\\r\\n    supported-color-schemes: light dark only;\\r\\n  }\\r\\n\\r\\n  /**\\r\\n   * Avoid browser level font resizing.\\r\\n   * 1. Windows Mobile\\r\\n   * 2. iOS / OSX\\r\\n   */\\r\\n  body,\\r\\n  table,\\r\\n  td,\\r\\n  a {\\r\\n    -ms-text-size-adjust: 100%; /* 1 */\\r\\n    -webkit-text-size-adjust: 100%; /* 2 */\\r\\n    font-family: 'OpenAI Sans', Helvetica, Arial, sans-serif;\\r\\n  }\\r\\n\\r\\n  /**\\r\\n   * Remove extra space added to tables and cells in Outlook.\\r\\n   */\\r\\n  table,\\r\\n  td {\\r\\n    mso-table-rspace: 0pt;\\r\\n    mso-table-lspace: 0pt;\\r\\n    vertical-align: top; /* Align content to the top of table cells */\\r\\n  }\\r\\n\\r\\n  /**\\r\\n   * Better fluid images in Internet Explorer.\\r\\n   */\\r\\n  img {\\r\\n    -ms-interpolation-mode: bicubic;\\r\\n  }\\r\\n\\r\\n  /**\\r\\n   * Remove blue links for iOS devices.\\r\\n   */\\r\\n  a[x-apple-data-detectors] {\\r\\n    font-family: inherit !important;\\r\\n    font-size: inherit !important;\\r\\n    font-weight: inherit !important;\\r\\n    line-height: inherit !important;\\r\\n    color: inherit !important;\\r\\n    text-decoration: none !important;\\r\\n  }\\r\\n\\r\\n  /**\\r\\n   * Fix centering issues in Android 4.4.\\r\\n   */\\r\\n  div[style*=3D\\\"margin: 16px 0;\\\"] {\\r\\n    margin: 0 !important;\\r\\n  }\\r\\n\\r\\n  body {\\r\\n    width: 100% !important;\\r\\n    height: 100% !important;\\r\\n    padding: 0 !important;\\r\\n    margin: 0 !important;\\r\\n  }\\r\\n\\r\\n  /**\\r\\n   * Collapse table borders to avoid space between cells.\\r\\n   */\\r\\n  table {\\r\\n    border-collapse: collapse !important;\\r\\n  }\\r\\n\\r\\n  a {\\r\\n    color: #898A8D;\\r\\n  }\\r\\n\\r\\n  .image-reset-bullets,\\r\\n  .image-reset-bullets .email-bullet-link {\\r\\n      color: #000000;\\r\\n  }\\r\\n\\r\\n  /* Give the ChatGPT logo pill consistent breathing room in light mode. */\\r\\n  .email-logo-pill {\\r\\n      background-color: #ffffff;\\r\\n      border-radius: 12px;\\r\\n      padding: 13px;\\r\\n      display: inline-block;\\r\\n  }\\r\\n\\r\\n  img {\\r\\n    height: auto;\\r\\n    line-height: 100%;\\r\\n    text-decoration: none;\\r\\n    border: 0;\\r\\n    outline: none;\\r\\n  }\\r\\n\\r\\n  /* Composer image sizing (mobile default) */\\r\\n  .composer-img {\\r\\n      width: 83px !important;\\r\\n      height: auto !important;\\r\\n      padding: 16px !important;\\r\\n  }\\r\\n\\r\\n  h1 {\\r\\n      font-size: 34px;\\r\\n      line-height: 41px;\\r\\n      font-weight: 400;\\r\\n      letter-spacing: 0.4px;\\r\\n      margin: 0;\\r\\n  }\\r\\n  h2 {\\r\\n      font-size: 18px;\\r\\n      font-weight: 400;\\r\\n      margin: 0;\\r\\n      line-height: 150%;\\r\\n      letter-spacing: -0.2px;\\r\\n  }\\r\\n  p {\\r\\n      font-size: 16px;\\r\\n      line-height: 130%;\\r\\n      font-weight: 500;\\r\\n      margin: 0;\\r\\n  }\\r\\n  p + p {\\r\\n      margin-top: 16px;\\r\\n  }\\r\\n  /* Intro blocks (H1/H2) sizing */\\r\\n  .intro-block {\\r\\n      width: 345px !important;\\r\\n      max-width: 345px !important;\\r\\n  }\\r\\n  /* Composer card sizing */\\r\\n  .composer-card {\\r\\n      width: 377px !important;\\r\\n      max-width: 377px !important;\\r\\n  }\\r\\n  /* Button styling */\\r\\n  a.button {\\r\\n      background-color: #000000 !important; /* default black */\\r\\n      border-radius: 24px !important; /* make button curvy */\\r\\n      padding: 11.5px 24px 11.5px !important; /* bigger size */\\r\\n      font-size: 16px !important; /* revert text size */\\r\\n      line-height: 24px !important;\\r\\n  }\\r\\n\\r\\n  a.button:active {\\r\\n      background-color: #414141 !important; /* dark gray on click */\\r\\n      border-radius: 36px !important;\\r\\n  }\\r\\n  /* CTA button hover state (supported clients only) */\\r\\n  a.button-invert:hover,\\r\\n  a.button-invert:focus {\\r\\n      background-color: #000000 !important;\\r\\n      background-image: none !important;\\r\\n      color: #FFFFFF !important;\\r\\n      border-color: #FFFFFF !important;\\r\\n  }\\r\\n  a.button-invert:hover span,\\r\\n  a.button-invert:focus span {\\r\\n      color: #FFFFFF !important;\\r\\n  }\\r\\n  @media (prefers-color-scheme: dark) {\\r\\n      a.button-invert {\\r\\n          background-color: #FFFFFF !important;\\r\\n          background-image: linear-gradient(#FFFFFF, #FFFFFF) !important;\\r\\n          color: #000000 !important;\\r\\n          border-color: #FFFFFF !important;\\r\\n          -webkit-text-fill-color: #000000 !important;\\r\\n      }\\r\\n      a.button-invert span {\\r\\n          color: #000000 !important;\\r\\n          -webkit-text-fill-color: #000000 !important;\\r\\n      }\\r\\n  }\\r\\n  [data-ogsc] a.button-invert,\\r\\n  [data-ogsb] a.button-invert {\\r\\n      background-color: #FFFFFF !important;\\r\\n      background-image: linear-gradient(#FFFFFF, #FFFFFF) !important;\\r\\n      color: #000000 !important;\\r\\n      border-color: #FFFFFF !important;\\r\\n      -webkit-text-fill-color: #000000 !important;\\r\\n  }\\r\\n  [data-ogsc] a.button-invert span,\\r\\n  [data-ogsb] a.button-invert span {\\r\\n      color: #000000 !important;\\r\\n      -webkit-text-fill-color: #000000 !important;\\r\\n  }\\r\\n  /* Ensure hover keeps text legible even with dark-mode overrides. */\\r\\n  a.button-invert:hover,\\r\\n  a.button-invert:focus {\\r\\n      color: #FFFFFF !important;\\r\\n      -webkit-text-fill-color: #FFFFFF !important;\\r\\n  }\\r\\n  a.button-invert:hover span,\\r\\n  a.button-invert:focus span {\\r\\n      color: #FFFFFF !important;\\r\\n      -webkit-text-fill-color: #FFFFFF !important;\\r\\n  }\\r\\n  /* Badges: use real rows so the stacked layout survives across email clie=\\r\\nnts */\\r\\n  .badges {\\r\\n      width: 100% !important;\\r\\n      max-width: 128px !important;\\r\\n  }\\r\\n  .badges .badge {\\r\\n      width: 100% !important;\\r\\n      vertical-align: bottom !important;\\r\\n  }\\r\\n  .badges .badge img {\\r\\n      width: 120px !important;\\r\\n      max-width: 120px !important;\\r\\n      height: auto !important;\\r\\n      margin: 0 auto !important;\\r\\n  }\\r\\n\\r\\n  /* Desktop: larger typography */\\r\\n  @media screen and (min-width:480px) {\\r\\n      h1 {\\r\\n          font-size: 34px !important;\\r\\n          line-height: 41px !important;\\r\\n          letter-spacing: 0.4px;\\r\\n          font-weight: 400 !important;\\r\\n      }\\r\\n      h2 {\\r\\n        font-size: 18px;\\r\\n        font-weight: 400;\\r\\n        margin: 0;\\r\\n        line-height: 150%;\\r\\n        letter-spacing: -0.2px;\\r\\n      }\\r\\n      /* Header cell: increase side padding on desktop only */\\r\\n      td.header-td {\\r\\n          padding-left: 57px !important;\\r\\n          padding-right: 57px !important;\\r\\n      }\\r\\n      /* Composer image sizing for desktop */\\r\\n      .composer-img {\\r\\n          width: 98px !important;\\r\\n      }\\r\\n      /* Body content cells: increase side padding on desktop */\\r\\n      td.content-